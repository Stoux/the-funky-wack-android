# Copy this file to secrets.properties and fill in your values
# Both secrets.properties and secrets.prod.properties are gitignored
#
# secrets.properties      - used for debug builds
# secrets.prod.properties - used for release builds (falls back to secrets.properties)

SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/1234567

# Public app key for the Laravel Reverb WebSocket server (listen-along).
# Auth still happens server-side via /api/broadcast/auth, but the client
# uses this to identify the app to Reverb. Grab from the prod server's
# .env (REVERB_APP_KEY).
REVERB_APP_KEY=
